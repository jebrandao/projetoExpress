# Perfil de desenvolvimento (NODE_ENV=development, que é o padrão)
PORT=3000

# Banco SQLite em arquivo: dá para abrir em um programa externo (ex.: DB Browser for SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./dados/dev.sqlite

# Mostra no console o SQL gerado pelo Sequelize
DB_LOG=true

# Carrega dados de exemplo ao iniciar a aplicação
SEED=true

# Chave de assinatura dos tokens JWT (só para desenvolvimento: 32 caracteres ou mais)
JWT_SECRET=chave-de-desenvolvimento-com-mais-de-32-caracteres
JWT_EXPIRACAO_SEGUNDOS=3600

# Sites autorizados a chamar a API pelo navegador (CORS)
CORS_ORIGENS=http://localhost:3000,http://localhost:5173
