# Modelo do perfil de produção (MySQL).
# Copie este arquivo para .env.production e preencha os valores reais.
# O arquivo .env.production NÃO deve ir para o Git (veja o .gitignore).
PORT=8080

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_api
DB_USER=root
DB_PASSWORD=troque-esta-senha

DB_LOG=false

# Em produção não carregamos dados de exemplo
SEED=false

# Chave de assinatura dos tokens JWT: gere uma chave longa e aleatória. Nunca use esta de exemplo.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRACAO_SEGUNDOS=3600

# Sites autorizados a chamar a API pelo navegador (CORS)
CORS_ORIGENS=https://meu-site.com.br
