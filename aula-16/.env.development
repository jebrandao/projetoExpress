# Perfil de desenvolvimento (NODE_ENV=development, que é o padrão)
PORT=3000

# Banco SQLite em arquivo: dá para abrir em um programa externo (ex.: DB Browser for SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./dados/dev.sqlite

# force: recria as tabelas a cada início (o banco de desenvolvimento recomeça do zero)
DB_SYNC=force

# Mostra no console o SQL gerado pelo Sequelize
DB_LOG=true

# Carrega dados de exemplo ao iniciar a aplicação
SEED=true
