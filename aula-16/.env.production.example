# Modelo do perfil de produção (MySQL).
# Copie este arquivo para .env.production e preencha os valores reais.
# O arquivo .env.production NÃO deve ir para o Git (veja o .gitignore).
PORT=8080

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_api
DB_USER=root
DB_PASSWORD=troque-esta-senha

# alter: ajusta as tabelas existentes sem apagar os dados
DB_SYNC=alter
DB_LOG=false

# Em produção não carregamos dados de exemplo
SEED=false
